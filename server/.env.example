# --- Database (Postgres, e.g. a Supabase project) ---
# Pooled connection (Supabase: port 6543, ?pgbouncer=true) for normal runtime queries.
DATABASE_URL=
# Direct connection (Supabase: port 5432), used only by `prisma migrate`.
DIRECT_URL=

# --- Auth ---
# Any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# --- File storage (Supabase Storage) ---
# Project Settings > Data API for the URL — use the bare project URL
# (https://xxxxx.supabase.co), NOT the "/rest/v1/" REST endpoint shown there.
SUPABASE_URL=
# Project Settings > API Keys > Legacy anon/service_role tab > service_role
# ("secret") key. Bypasses Row Level Security — never expose this client-side.
SUPABASE_SERVICE_ROLE_KEY=
# Create a private bucket named "candidate-documents" in Storage before running
# the app — CV/assessment-report uploads will fail with a bucket-not-found
# error until it exists.

# --- Server ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
