{
  "name": "campus-hiring-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "prisma:migrate": "npm run prisma:migrate --workspace=server",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "seed": "npm run seed --workspace=server"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "esbuild@0.21.5": true
  }
}
